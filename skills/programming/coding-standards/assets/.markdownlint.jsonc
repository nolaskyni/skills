{
  "default": true,
  "MD003": {"style": "atx"},
  "MD004": {"style": "dash"},
  "MD007": {"indent": 2},
  "MD013": {
    "line_length": 80,
    "tables": false,
    "headings": false,
    "code_blocks": false,
  },
  "MD033": {"allowed_elements": ["kbd", "picture", "source", "img"]},
  "MD035": {"style": "---"},
  "MD046": {"style": "fenced"},
  "MD048": {"style": "backtick"},
  "MD049": {"style": "underscore"},
  "MD050": {"style": "asterisk"},
}
