{
  "printWidth": 80,
  "singleQuote": true,
  "bracketSpacing": false,
  "proseWrap": "always",
  "jsdoc": {
    "addDefaultToDescription": false
  },
  "ignorePatterns": ["**/.vscode/**", "**/*.code-workspace", "**/Code/User/**"],
  "overrides": [
    {"files": ["*.jsonc"], "options": {"trailingComma": "none"}},
    {
      "files": ["skills/learning/*/assets/obsidian/*.md"],
      "options": {"proseWrap": "never"}
    }
  ]
}
